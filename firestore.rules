rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net: Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Security primitives & helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidCustomImage(dataExchange) {
      return dataExchange.keys().hasAll(['id', 'base64', 'updatedAt'])
        && dataExchange.keys().size() == 3
        && dataExchange.id is string
        && dataExchange.id.size() <= 128
        && dataExchange.base64 is string
        && dataExchange.base64.size() <= 150000;
    }

    // 3. custom_images Collection matching Rules
    match /custom_images/{imageId} {
      allow get: if true;
      allow list: if true;
      allow create: if isValidId(imageId) 
        && isValidCustomImage(request.resource.data);
      allow update: if isValidId(imageId) 
        && isValidCustomImage(request.resource.data);
      allow delete: if true;
    }
  }
}
